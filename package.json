{
  "name": "floccus-cf-worker",
  "version": "0.4.0",
  "private": true,
  "description": "Floccus-compatible WebDAV/XBEL bookmark sync on Cloudflare Workers + D1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node scripts/run.mjs wrangler dev --persist-to .cache/wrangler/state --var ALLOW_INSECURE_LOCALHOST:true",
    "test": "npm run upstream:prepare && node scripts/run.mjs vitest run",
    "test:watch": "node scripts/run.mjs vitest",
    "typecheck": "node scripts/generate-schema.mjs --check && node scripts/run.mjs tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run deploy:dry",
    "deploy": "node scripts/run.mjs wrangler deploy",
    "deploy:dry": "node scripts/run.mjs wrangler deploy --dry-run --outdir .cache/deploy",
    "db:local": "node scripts/run.mjs wrangler d1 migrations apply floccus-bookmarks --local --persist-to .cache/wrangler/state",
    "db:remote": "node scripts/run.mjs wrangler d1 migrations apply floccus-bookmarks --remote",
    "upstream:prepare": "node scripts/prepare-upstream.mjs",
    "test:upstream": "npm run upstream:prepare && node scripts/run.mjs vitest run tests/upstream.test.ts",
    "configure": "node scripts/configure.mjs",
    "client": "node scripts/client.mjs",
    "test:service": "node scripts/run.mjs vitest run tests/service.test.ts",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "test:bootstrap": "node scripts/run.mjs vitest run tests/bootstrap.test.ts",
    "schema:generate": "node scripts/generate-schema.mjs",
    "schema:check": "node scripts/generate-schema.mjs --check",
    "test:init": "node scripts/run.mjs vitest run tests/initialize.test.ts tests/bootstrap.test.ts",
    "test:password": "node scripts/run.mjs vitest run tests/password-auth.test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@jcoreio/async-throttle": "1.6.1",
    "@types/node": "24.19.2",
    "async-parallel": "1.2.3",
    "batching-toposort": "1.2.0",
    "esbuild": "0.28.2",
    "js-base64": "3.9.4",
    "lodash": "4.18.1",
    "miniflare": "5.20261012.1-beta",
    "ts-xxhash": "1.0.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrothKeiran/floccus-cf-worker.git"
  },
  "homepage": "https://github.com/GrothKeiran/floccus-cf-worker#readme",
  "bugs": {
    "url": "https://github.com/GrothKeiran/floccus-cf-worker/issues"
  },
  "keywords": [
    "floccus",
    "cloudflare-workers",
    "d1",
    "webdav",
    "bookmarks",
    "xbel"
  ]
}
